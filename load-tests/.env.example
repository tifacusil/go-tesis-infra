# load-tests/.env
# NUNCA commitear este archivo con valores reales.
# Copiar como .env y completar localmente:
#   cp load-tests/.env.example load-tests/.env
#
# Los scripts (run-all.sh, run-endurance.sh, chaos/*.sh) lo cargan
# automáticamente si existe.

# URL de Grafana accesible desde donde corren estos scripts.
# Default en grafana-annotate.sh si se omite: http://grafana:3000
GRAFANA_URL=http://grafana:3000

# Service account token de Grafana (rol Editor), generado en:
# Administration -> Users and access -> Service accounts -> Add service
# account -> Add service account token.
# Sin este valor, los scripts corren igual pero sin anotar el dashboard.
GRAFANA_API_TOKEN=

# Valores de secretos en claro — NUNCA versionar. Solo se versionan los
# SealedSecret cifrados que produce kubeseal.
bootstrap/secrets.env
*.secrets.env

# Backup de la clave privada del controller sealed-secrets.
*sealed-secrets-key*.yaml

# SealedSecret generados localmente (cifrados con la clave de OTRO cluster).
# Cada entorno (VPS) sella los suyos con su propia clave; no se versionan los de prueba.
overlays/prod/sealed-secrets/*.yaml
!overlays/prod/sealed-secrets/kustomization.yaml

# Overlay de prueba local (k3d), no para producción.
overlays/local/

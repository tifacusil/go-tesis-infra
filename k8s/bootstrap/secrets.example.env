# Plantilla de secretos para sellar con kubeseal (bootstrap/seal-secrets.sh).
#
# USO:
#   1. cp secrets.example.env secrets.env   (secrets.env está gitignored)
#   2. rellenar con los valores REALES
#   3. ./seal-secrets.sh secrets.env        → genera los SealedSecret cifrados
#
# Los valores aquí son placeholders. NUNCA commitear secrets.env con valores reales;
# solo se versionan los SealedSecret cifrados que produce kubeseal.

# ── MySQL root (uno por base, database-per-service) ──────────────────────────
MYSQL_DATA_MANAGEMENT_ROOT_PASSWORD=changeme
MYSQL_USER_MANAGEMENT_ROOT_PASSWORD=changeme
MYSQL_PROJECT_MANAGEMENT_ROOT_PASSWORD=changeme
MYSQL_EARLY_WARNING_ROOT_PASSWORD=changeme

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=changeme

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=changeme
RABBITMQ_ERLANG_COOKIE=changeme-cookie

# ── data-receiving (Go, prefijo RECEIVER__) ──────────────────────────────────
# El connection string de Redis lleva el password inline.
RECEIVER_REDIS_CONNECTIONSTRING=redis:6379,password=changeme
RECEIVER_RABBITMQ_PASSWORD=changeme

# ── data-management (Go) ─────────────────────────────────────────────────────
DATA_MGMT_RABBITMQ_PASSWORD=changeme
DATA_MGMT_MYSQL_PASSWORD=changeme

# ── data-analysis (Python, réplica read-only) ────────────────────────────────
DATA_ANALYSIS_MYSQL_PASSWORD=changeme

# ── early-warning (Go) ───────────────────────────────────────────────────────
EW_RABBITMQ_PASSWORD=changeme
EW_REDIS_PASSWORD=changeme
EW_MYSQL_PASSWORD=changeme

# ── user-management (Go, conecta como root) ──────────────────────────────────
USER_MGMT_DB_PASS=changeme
USER_MGMT_DB_ROOT_PASS=changeme
USER_MGMT_JWT_SECRET=changeme_min_32_chars_xxxxxxxxxxxxxx

# ── project-management (Go, conecta como root) ───────────────────────────────
PROJECT_MGMT_DB_PASS=changeme
PROJECT_MGMT_DB_ROOT_PASS=changeme

# ── observabilidad — mysqld-exporter ─────────────────────────────────────────
# El usuario 'exporter' no lo crea el initdb. Después de sellar y desplegar
# (y tras cualquier reinicio de un datadir), crearlo con:
#   sudo sh k8s/bootstrap/mysql-exporter-user.sh
MYSQLD_EXPORTER_PASSWORD=changeme

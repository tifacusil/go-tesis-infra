# data-management — variables del microservicio (Go).
# Los nombres coinciden EXACTO con lo que lee internal/config/config.go.

# RabbitMQ
RABBITMQ_HOST=rabbitmq-1
RABBITMQ_PORT=5672
RABBITMQ_USER=data_management
RABBITMQ_PASSWORD=changeme_data_management
RABBITMQ_QUEUE=data_management.persist
# RABBITMQ_LISTENERS_ENABLED=true   # default true; false desactiva el consumer

# MySQL — BD exclusiva de este servicio. El servicio arma el DSN desde estas partes
# (parseTime=true&loc=UTC fijos). Usuario runtime con permisos minimos (sin DDL);
# el esquema lo crea el init de mysql-data-management.
MYSQL_HOST=mysql-data-management
MYSQL_PORT=3306
MYSQL_DATABASE=data_management
MYSQL_USER=svc_data_mgmt
MYSQL_PASSWORD=changeme_data_mgmt

# Consul — el servicio arma la URL como http://CONSUL_HOST:CONSUL_PORT
CONSUL_HOST=consul-1
CONSUL_PORT=8500
CONSUL_TOKEN=
# CONSUL_ENABLED=true               # default true
# CONSUL_SERVICE_NAME=data-management
# SERVICE_IP=                       # si vacio, autodetecta IPv4 del contenedor

# App
ENV=dev
# Nota: LOG_LEVEL aun no lo lee el servicio (slog fija nivel info). Reservado.
LOG_LEVEL=info

# HTTP_PORT e INSTANCE_ID se inyectan por instancia desde el docker-compose.

# MySQL — BD exclusiva de este servicio
MYSQL_HOST=mysql-project-management
MYSQL_PORT=3306
MYSQL_DATABASE=project_management
MYSQL_USER=svc_project_mgmt
MYSQL_PASSWORD=changeme_project_mgmt
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25

# Consul (fail-fast=false: app boots even if Consul down)
CONSUL_ENABLED=true
CONSUL_HOST=consul-1
CONSUL_PORT=8500
CONSUL_TOKEN=
CONSUL_HEALTH_INTERVAL=10s

# App
LOG_LEVEL=info
ENV=dev

SERVICE_NAME=project-management-service
SERVICE_VERSION=0.1.0

HTTP_PORT=8080
# host.docker.internal: el contenedor Consul debe alcanzar el /health del
# servicio corriendo en el host. 127.0.0.1 apuntaría al propio contenedor.
ADVERTISE_HOST=host.docker.internal
HEALTH_PATH=/health

# Migration credentials (root, DDL). Solo se usan al startup para goose up.
DB_ROOT_USER=root
DB_ROOT_PASS=changeme_root

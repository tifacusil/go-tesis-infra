# Overrides por instancia — data-analysis-1. Carga tras data-analysis.env.
ANALYSIS__INSTANCE_ID=data-analysis-01
ANALYSIS__HTTP_PORT=8080
ANALYSIS__GRPC_PORT=50051
# La app deriva el check_host del registro Consul desde ANALYSIS__HOST: si es
# 0.0.0.0 usa 127.0.0.1 (inalcanzable desde Consul). Bind al hostname real del
# contenedor → check http://data-analysis-1:8080/health alcanzable.
ANALYSIS__HOST=data-analysis-1

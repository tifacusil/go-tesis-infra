# RabbitMQ
RABBITMQ_HOST=rabbitmq-1
RABBITMQ_PORT=5672
RABBITMQ_USER=data_receiving
RABBITMQ_PASSWORD=changeme_data_receiving
RABBITMQ_EXCHANGE=sensors.raw

# Redis (buffer antes de ACK de RabbitMQ)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis

# Consul
CONSUL_HOST=consul-1
CONSUL_PORT=8500
CONSUL_TOKEN=

# App
LOG_LEVEL=info
ENV=dev
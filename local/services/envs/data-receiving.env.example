# Plantilla de configuración de data-receiving (Go).
# Copiar como data-receiving.env (gitignored) y completar los secretos.
# El binario lee variables con prefijo RECEIVER__ y __ como separador de sección.
# Lo que varía por instancia (INSTANCEID, puertos) va en el compose, no aquí.

RECEIVER__OUTPUTMODE=rabbitmq
RECEIVER__DLXPATH=/tmp/dlx

# Redis — el password va inline en el connection string: host:port,password=<secret>
RECEIVER__REDIS__CONNECTIONSTRING=redis:6379,password=<Redis password>
RECEIVER__REDIS__BUFFERTLTHOURS=24
RECEIVER__REDIS__RETRYINTERVALSECONDS=30
RECEIVER__REDIS__RETRYMINAGEMINUTES=2

# RabbitMQ
RECEIVER__RABBITMQ__HOST=rabbitmq-1
RECEIVER__RABBITMQ__PORT=5672
RECEIVER__RABBITMQ__VIRTUALHOST=/
RECEIVER__RABBITMQ__USERNAME=data_receiving
RECEIVER__RABBITMQ__PASSWORD=<RabbitMQ password>
RECEIVER__RABBITMQ__EXCHANGE=sensors.raw
RECEIVER__RABBITMQ__CONFIRMTIMEOUTSECONDS=5

# Consul
RECEIVER__CONSUL__ADDRESS=http://consul-1:8500
RECEIVER__CONSUL__TOKEN=
RECEIVER__CONSUL__SERVICEVERSION=1.0.0
RECEIVER__CONSUL__ENVIRONMENT=dev

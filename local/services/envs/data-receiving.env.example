# Plantilla de configuración de data-receiving (Go).
# Copiar como data-receiving.env (gitignored) y completar los secretos.
# El binario lee variables de entorno con nombres Go-style (igual que el resto
# del fleet). Lo que varía por instancia (INSTANCE_ID, puertos, ADVERTISE_HOST)
# va en el compose, no aquí.

# App
SERVICE_NAME=data-receiving
ENV=dev
HEALTH_PATH=/health
# SERVICE_VERSION lo fija el build (ldflags -X); no se lee de env.

# Modo de salida: stdout | file | null | rabbitmq.
OUTPUT_MODE=rabbitmq
DLX_PATH=/tmp/dlx

# Redis — buffer de durabilidad (host/port/password separados).
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis
REDIS_DB=0
BUFFER_TTL_HOURS=24
RETRY_INTERVAL_SECONDS=30
RETRY_MIN_AGE_MINUTES=2

# RabbitMQ — productor de sensors.raw.
RABBITMQ_HOST=rabbitmq-1
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_USERNAME=data_receiving
RABBITMQ_PASSWORD=changeme_rabbitmq
RABBITMQ_EXCHANGE=sensors.raw
RABBITMQ_CONFIRM_TIMEOUT_SECONDS=5

# Consul (fail-fast=false: la app arranca aunque Consul esté caído).
CONSUL_ENABLED=true
CONSUL_HOST=consul-1
CONSUL_PORT=8500
CONSUL_TOKEN=
CONSUL_HEALTH_INTERVAL=10s

# RabbitMQ
RABBITMQ_HOST=rabbitmq-1
RABBITMQ_PORT=5672
RABBITMQ_USER=early_warning
RABBITMQ_PASSWORD=changeme_early_warning
RABBITMQ_QUEUE=early_warning.evaluate

# MySQL — BD exclusiva de este servicio (alertas y umbrales)
MYSQL_HOST=mysql-early-warning
MYSQL_PORT=3306
MYSQL_DATABASE=early_warning
MYSQL_USER=svc_early_warning
MYSQL_PASSWORD=changeme_early_warning

# data-analysis — llamada HTTP con circuit breaker
DATA_ANALYSIS_URL=http://data-analysis-1:8080
DATA_ANALYSIS_TIMEOUT_MS=5000
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000

# Consul
CONSUL_HOST=consul-1
CONSUL_PORT=8500
CONSUL_TOKEN=

# App
LOG_LEVEL=info
ENV=dev
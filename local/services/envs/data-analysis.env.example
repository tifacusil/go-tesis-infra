# MySQL — réplica de lectura de data-management (usuario read-only)
# data-analysis NO escribe a ninguna BD.
MYSQL_HOST=mysql-data-management
MYSQL_PORT=3306
MYSQL_DATABASE=data_management
MYSQL_USER=svc_data_analysis_ro
MYSQL_PASSWORD=changeme_data_analysis_ro

# Consul — la app Python lee con prefijo ANALYSIS__ y __ por sección.
# Sin el prefijo cae al default localhost:8500 → register refused.
ANALYSIS__CONSUL__HOST=consul-1
ANALYSIS__CONSUL__PORT=8500
ANALYSIS__CONSUL__TOKEN=

# App
LOG_LEVEL=info
ENV=dev
# App
SERVICE_NAME=user-management-service
SERVICE_VERSION=0.1.0
ENV=dev
ADVERTISE_HOST=user-management-1
GRPC_ADDR=:9090

# Runtime DB (least-privilege: SELECT/INSERT/UPDATE/DELETE)
DB_HOST=mysql-user-management
DB_PORT=3306
DB_USER=svc_user_mgmt
DB_PASS=changeme_user_mgmt
DB_NAME=user_management

# Migration DB (root, DDL only at startup via goose)
DB_ROOT_USER=root
DB_ROOT_PASS=changeme_root

# JWT
JWT_SECRET=changeme_jwt_secret_min_32_chars_local
JWT_EXPIRY_HOURS=24

# Upstream services
PROJECT_MANAGEMENT_URL=http://project-management-1:8080

# Consul
CONSUL_ENABLED=true
CONSUL_HOST=consul-1
CONSUL_PORT=8500
CONSUL_TOKEN=
CONSUL_HEALTH_INTERVAL=10s

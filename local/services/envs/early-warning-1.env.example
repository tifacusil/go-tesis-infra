# Overrides por instancia — early-warning-1. Carga tras early-warning.env.
INSTANCE_ID=early-warning-01
HTTP_PORT=8080
# La app arma el HealthURL de Consul con CONSUL_SERVICE_ADDRESS (default=INSTANCE_ID).
# INSTANCE_ID es early-warning-01 pero el hostname del contenedor es early-warning-1
# → sin esto Consul prueba http://early-warning-01:8080/health (DNS no resuelve) →
# check critical → deregister. Apuntar al hostname real del contenedor.
CONSUL_SERVICE_ADDRESS=early-warning-1

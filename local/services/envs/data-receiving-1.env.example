# Overrides por instancia — data-receiving-1.
# Se carga DESPUÉS de data-receiving.env (común) en el env_file del compose.
# La app lee env con prefijo RECEIVER__ y __ como separador de sección.
RECEIVER__PORT=5000
RECEIVER__CONSUL__INSTANCEID=data-receiving-01
RECEIVER__CONSUL__HEALTHPORT=8080
# Consul (otro contenedor) alcanza /health por el hostname del servicio en
# landslide-net, no localhost (apuntaría a Consul mismo).
RECEIVER__CONSUL__HEALTHCHECKHOST=data-receiving-1

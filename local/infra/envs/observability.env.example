# envs/observability.env
# NUNCA commitear este archivo con valores reales.
# Copiar como observability.env y completar localmente.

# DSN para mysqld_exporter (formato: user:pass@tcp(host:port)/)
# Root tiene acceso a PERFORMANCE_SCHEMA — necesario para mysqld_exporter
MYSQL_DATA_MANAGEMENT_DSN=root:changeme_root@tcp(mysql-data-management:3306)/
MYSQL_USER_MANAGEMENT_DSN=root:changeme_root@tcp(mysql-user-management:3306)/
MYSQL_PROJECT_MANAGEMENT_DSN=root:changeme_root@tcp(mysql-project-management:3306)/
MYSQL_EARLY_WARNING_DSN=root:changeme_root@tcp(mysql-early-warning:3306)/

# Credenciales RabbitMQ management API (usuario admin del compose base)
RABBITMQ_ADMIN_USER=admin
RABBITMQ_ADMIN_PASS=changeme_admin

# Contraseña Redis (debe coincidir con envs/redis.env)
REDIS_PASSWORD=changeme_redis

# Grafana (opcional; por defecto admin/admin)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASS=changeme_grafana

# envs/rabbitmq.env
# NUNCA commitear este archivo con valores reales.
# Copiar como rabbitmq.env y completar localmente.

RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=changeme_admin

# Contraseñas de usuarios por servicio
# RabbitMQ las lee desde definitions.json; estos valores
# se usan para setear los hashes al levantar por primera vez.
RABBITMQ_USER_DATA_RECEIVING_PASS=changeme_data_receiving
RABBITMQ_USER_DATA_MANAGEMENT_PASS=changeme_data_management
RABBITMQ_USER_EARLY_WARNING_PASS=changeme_early_warning
RABBITMQ_USER_DLQ_INSPECTOR_PASS=changeme_dlq_inspector

# Cookie Erlang compartida entre nodos del cluster
RABBITMQ_ERLANG_COOKIE=local-dev-cookie-change-in-prod

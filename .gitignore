# Ignorar todo .env dentro de cualquier carpeta envs/
**/envs/**/*.env

# Excepto .env.example
!**/envs/**/*.env.example

# .env de load-tests/ (GRAFANA_API_TOKEN, etc.) — nunca commitear con valores reales
load-tests/.env
!load-tests/.env.example

# Resultados de Artillery (JSONs y HTMLs generados — no van al repo)
load-tests/results/*/
!load-tests/results/.gitkeep

# Datos de volúmenes (bind mounts) — generados al levantar docker compose
**/consul-data-1/
**/rabbitmq-data-1/
**/redis-data/
**/mysql-data/

# Centinela de parada del muestreo continuo (chaos/lib/sampler.sh) — efimero.
# Los CSV de muestreo SI se versionan: son la evidencia de las inyecciones,
# igual que los .snapshot.
chaos/results/*.stop
